# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
NEXT_PUBLIC_SITE_URL=https://proexcel.store
NEXT_PUBLIC_SITE_NAME=ProExcel

# Upstash Redis (for distributed rate limiting in serverless/Edge)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Scraper & Image Permission Gate (Default: false)
MYLIBRAIRIE_IMAGES_APPROVED=false
